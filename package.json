{
    "name": "pdf-chatbot",
    "description": "AI PDF chatbot powered by LangChain and LangGraph",
    "private": true,
    "version": "0.1.0",
    "author": "Steve Zhang",
    "license": "MIT",
    "workspaces": [
      "backend",
      "frontend"
    ],
    "scripts": {
